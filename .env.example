# Salin menjadi .env lalu sesuaikan.
# Catatan: semua variabel VITE_* ikut ter-bundle ke browser dan bisa dibaca siapa pun.
# Jangan menaruh rahasia sungguhan di sini.

# true = semua request API dilayani data demo di browser (localStorage), tanpa backend.
VITE_USE_DEMO_DATA=true

# Host backend (tanpa /api). Pada mode demo cukup diisi URL dev server.
VITE_URL=http://localhost:5173

# Dipakai untuk header AuthToken dan penyamaran ID di URL. Kosongkan pada mode demo.
VITE_TOKEN=
VITE_REACT_APP_KEY=
